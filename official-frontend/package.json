{
  "name": "buyna-ai-official",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run cf:prepare",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "pnpm run lint && pnpm run check:content && pnpm run build",
    "check:content": "node scripts/check-official-content.mjs",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "check:github-source": "node scripts/check-github-source.mjs",
    "github:source-plan": "node scripts/print-github-source-plan.mjs",
    "check:cloudflare-account": "node scripts/check-cloudflare-account.mjs",
    "cloudflare:env-plan": "node scripts/print-cloudflare-env-plan.mjs",
    "supabase:migration-plan": "node scripts/print-supabase-migration-plan.mjs",
    "globepay:dashboard-plan": "node scripts/print-globepay-dashboard-plan.mjs",
    "payment:verification-plan": "node scripts/print-payment-verification-plan.mjs",
    "production:readiness-plan": "node scripts/print-production-readiness-plan.mjs",
    "prod-evidence:plan": "node scripts/print-production-evidence-plan.mjs",
    "prod-evidence:todo": "node scripts/print-production-evidence-todo.mjs",
    "handoff:summary": "node scripts/print-handoff-summary.mjs",
    "prod-evidence:init": "node scripts/init-production-evidence.mjs",
    "check:prod-evidence": "node scripts/check-production-evidence.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "audit:goal": "node scripts/audit-official-goal.mjs",
    "audit:goal:strict": "node scripts/audit-official-goal.mjs --strict",
    "package:check": "node scripts/check-update-package.mjs",
    "package:update": "node scripts/package-update.mjs",
    "resume:after-access": "node scripts/resume-after-access.mjs",
    "resume:status": "node scripts/show-resume-status.mjs",
    "resume:watch": "node scripts/resume-after-access.mjs --watch --interval-seconds 300",
    "resume:deploy-after-access": "node scripts/resume-after-access.mjs --watch --interval-seconds 300 --deploy-when-ready --base-url https://www.buyna.ai/",
    "resume:watch:background:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-resume-watch.ps1",
    "resume:deploy-after-access:background:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-resume-watch.ps1 -DeployWhenReady",
    "preview:local": "node scripts/local-preview.mjs start --restart",
    "preview:local:status": "node scripts/local-preview.mjs status",
    "preview:local:stop": "node scripts/local-preview.mjs stop",
    "smoke:local": "node scripts/smoke-official-site.mjs",
    "smoke:url": "node scripts/smoke-official-site.mjs --ai-mode optional",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "cf:prepare": "node scripts/prepare-cloudflare-config.mjs",
    "cf:clean": "node scripts/clean-wrangler-deploy-state.mjs",
    "cf:check": "pnpm run build && pnpm run cf:clean && wrangler --cwd .output/server deploy --dry-run --outdir ../../.wrangler/dry-run",
    "cf:preview": "pnpm run build && pnpm run cf:clean && wrangler --cwd .output/server dev",
    "cf:deploy:dry-run": "pnpm run build && pnpm run cf:clean && wrangler --cwd .output/server deploy --dry-run --outdir ../../.wrangler/dry-run",
    "cf:deploy": "pnpm run build && pnpm run cf:clean && wrangler --cwd .output/server deploy --keep-vars"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/query-core": "^5.83.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.7.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "wrangler": "^4.107.0"
  }
}
