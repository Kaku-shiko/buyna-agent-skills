# Production template for the Buyna.ai official site.
# Copy to .env.production for local preflight only. Do not commit .env.production.
# Configure the same values in Cloudflare dashboard variables and Worker secrets.

# Public browser-safe Supabase values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-side Supabase values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Official production origin used for return URLs.
PUBLIC_SITE_URL=https://www.buyna.ai
APP_URL=https://www.buyna.ai

# AI shopping guide. Keep these server-side only.
# Do not add VITE_LOVABLE_API_KEY or VITE_OPENAI_API_KEY.
LOVABLE_API_KEY=
OPENAI_API_KEY=

# GlobePay Japan production.
# Confirm these callback URLs in the GlobePay merchant dashboard before deploy.
# Do not add VITE_GLOBEPAY_CREDENTIAL_CODE.
GLOBEPAY_MODE=live
GLOBEPAY_API_BASE_URL=https://pay.globepay.co.jp
GLOBEPAY_BASE_URL=https://pay.globepay.co.jp/api/v1.0
GLOBEPAY_PARTNER_CODE=
GLOBEPAY_CREDENTIAL_CODE=
GLOBEPAY_NOTIFY_URL=https://www.buyna.ai/api/public/globepay/notify
GLOBEPAY_RECURRING_NOTIFY_URL=https://www.buyna.ai/api/public/globepay-recurring-notify
GLOBEPAY_RETURN_URL=https://www.buyna.ai/subscription/return

# Used to encrypt stored billing/member tokens. Generate a long random value.
BILLING_TOKEN_ENCRYPTION_KEY=

# Optional platform account fallback.
PLATFORM_ACCOUNT_URL=
PLATFORM_SUBSCRIPTION_API_URL=
# Do not add VITE_PLATFORM_SUBSCRIPTION_API_KEY.
PLATFORM_SUBSCRIPTION_API_KEY=
