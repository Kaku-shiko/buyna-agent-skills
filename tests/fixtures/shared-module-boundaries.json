{
  "presentationStylesheetExtensions": ["css", "scss", "sass", "less", "styl", "stylus"],
  "uiExportPatterns": [
    "(?:^|\\s)\\.\\/(?:react|components?)(?=\\s|$)",
    "(?:^|\\s)\\.\\/(?:styles?|theme)(?:\\.[a-z]+)?(?=\\s|$)",
    "\\.(?:tsx|jsx|vue|svelte)$"
  ],
  "merchantIdentifierPatterns": [
    "\\b(?:medinance|asuka|sanwa|tuyipaiban|bluesequoia)\\b"
  ],
  "productionIdentifierPatterns": [
    "\\bhttps?:\\/\\/[^\\s\\\"']+",
    "\\b(?:[a-z0-9-]+\\.)+(?:com|net|org|io|ai|jp|life|co|dev|app)\\b",
    "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
    "\\barn:(?:aws|aws-cn|aws-us-gov):"
  ],
  "sharedSourceProhibitedPatterns": {
    "merchantIdentifiers": [
      "\\b(?:medinance|asuka|sanwa|tuyipaiban|bluesequoia)\\b"
    ],
    "credentials": [
      "\\b(?:password|passwd|secret(?:_key)?|credential_code|access_key_id|private_key)\\b"
    ],
    "providerTransport": [
      "\\b(?:fetch|axios|got)\\s*\\(",
      "\\b(?:globepay|worldpay|stripe)\\b"
    ],
    "sqlOrOrm": [
      "\\b(?:SELECT|INSERT\\s+INTO|UPDATE\\s+[A-Za-z_][A-Za-z0-9_]*\\s+SET|DELETE\\s+FROM)\\b",
      "\\b(?:prisma|drizzle|sequelize|typeorm)\\b"
    ],
    "awsMutation": [
      "@aws-sdk/",
      "\\b(?:CreateBucket|RunInstances|CreateDBInstance|CreateTable|PutObjectCommand)\\b"
    ]
  }
}
