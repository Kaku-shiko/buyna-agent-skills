{
  "presentationStylesheetExtensions": ["css", "scss", "sass", "less", "styl", "stylus"],
  "uiExportPatterns": [
    "(?:^|\\s)\\.\\/(?:react|components?)(?=\\s|$)",
    "(?:^|\\s)\\.\\/(?:styles?|theme)(?:\\.[a-z]+)?(?=\\s|$)",
    "\\.(?:tsx|jsx|vue|svelte)$"
  ],
  "merchantIdentifierPatterns": [
    "\\b(?:medinance|asuka|sanwa|tuyipaiban|bluesequoia)\\b"
  ],
  "productionIdentifierPatterns": [
    "\\bhttps?:\\/\\/[^\\s\\\"']+",
    "\\b(?:[a-z0-9-]+\\.)+(?:com|net|org|io|ai|jp|life|co|dev|app)\\b",
    "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
    "\\barn:(?:aws|aws-cn|aws-us-gov):"
  ]
}
